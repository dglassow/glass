{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glass",
  "version": "0.1.5",
  "identifier": "com.glassow.glass",
  "build": {
    "frontendDist": "../../viewer/dist-web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @glass/viewer dev",
    "beforeBuildCommand": "pnpm --filter @glass/viewer build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Glass",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": ["backend/**/*", "backend/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://hub.glassow.com/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMDIzNkMyOUI3NjQ3MzUKUldRMVIzYWJ3allDSGUrdHNmR1JyY2UwYUZTOVhKbGhJWTVRRG1qOFU2TWliMlN5UEZZMWxMKzEK"
    }
  }
}
