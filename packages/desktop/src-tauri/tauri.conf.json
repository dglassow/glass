{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glass",
  "version": "0.0.0",
  "identifier": "com.glassow.glass",
  "build": {
    "frontendDist": "../../viewer/dist-web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @glass/viewer dev",
    "beforeBuildCommand": "pnpm --filter @glass/viewer build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Glass",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
