# Glass relay — systemd unit TEMPLATE (deployed to /etc/systemd/system/).
#
# The relay is a dumb pipe: it terminates NO TLS, holds NO certificate or
# private key, and never parses Glass protocol frames. The only per-install
# file it reads is /etc/glass-relay/hub.pub — the hub's PUBLIC Ed25519
# identity key (base64url, same encoding as protocol/src/auth.ts), which the
# relay uses to challenge the hub's outbound control connection so nobody else
# can register as the hub. That file lives on the VPS and in the backup
# bundle, never in the repo.
#
# Paths below are the conventional deploy locations; adjust on the box, not
# in the repo.

[Unit]
Description=Glass relay (dumb TLS-passthrough pipe)
Documentation=https://github.com/OWNER/glass (packages/relay)
After=network-online.target
Wants=network-online.target

[Service]
User=glass
Group=glass
ExecStart=/usr/bin/node /opt/glass-relay/dist/main.js \
  --listen 0.0.0.0:443 \
  --hub-pubkey-file /etc/glass-relay/hub.pub
Restart=always
RestartSec=2
LimitNOFILE=65536

# Bind 443 without root; everything else locked down.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
ReadOnlyPaths=/etc/glass-relay /opt/glass-relay

[Install]
WantedBy=multi-user.target
